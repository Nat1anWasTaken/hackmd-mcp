# Externally visible origin; OAuth metadata and the MCP resource URL derive from it.
PUBLIC_URL=http://localhost:8080
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://hackmd_mcp:hackmd_mcp@localhost:5444/hackmd_mcp

# HackMD API root. Defaults to https://api.hackmd.io/v1.
HACKMD_API_URL=
# Comma-separated HackMD user paths or emails allowed to sign in. Empty allows anyone.
ALLOWED_HACKMD_USERS=

# 32 random bytes, base64. Encrypts HackMD API tokens at rest: `openssl rand -base64 32`
ENCRYPTION_KEY=

# Production only (docker-compose.yml): password for the bundled Postgres.
# DATABASE_URL is derived from it there.
POSTGRES_PASSWORD=
